# This file is intentionally committed — it's a deliberate zero-config
# choice, not an oversight. The default below is harmless (a localhost URL,
# no secrets) and lets `npm install && npm run dev` work with no setup.
# .gitignore only excludes .env*.local — for a machine-specific override
# (e.g. pointing at a LAN host's IP for cross-device testing, see README's
# "Testing from another device on your LAN"), create web/.env.local instead
# of editing this file; Next.js applies .env.local on top of this one, and
# .env.local is gitignored so your override never gets committed.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
